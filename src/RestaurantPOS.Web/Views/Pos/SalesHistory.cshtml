@model List<Sale>
@{
    ViewData["Title"] = "Sales Invoices";
    var selectedDate = (DateTime)(ViewBag.SelectedBusinessDate ?? DateTime.Today);
}
<div class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Sales Invoices by Business Date</h5>
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="small fw-semibold">Business Date:</label>
            <input type="date" name="businessDate" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Invoice #</th>
                    <th>Business Date</th>
                    <th>Exact Sale Time (PKT)</th>
                    <th>Order Type</th>
                    <th>Payment</th>
                    <th class="text-end">Discount</th>
                    <th class="text-end">Total Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold">@s.InvoiceNumber</td>
                        <td><span class="badge bg-dark">@s.BusinessDate.ToString("dd MMM yyyy")</span></td>
                        <td>@s.SaleDateTime.ToString("dd MMM yyyy hh:mm:ss tt")</td>
                        <td>@s.OrderType @(s.RestaurantTable != null ? $"({s.RestaurantTable.TableNumber})" : "")</td>
                        <td>@s.PaymentMethod</td>
                        <td class="text-end">Rs. @s.DiscountAmount.ToString("N2")</td>
                        <td class="text-end fw-bold">Rs. @s.TotalAmount.ToString("N2")</td>
                        <td>
                            <span class="badge @(s.Status == SaleStatus.Completed ? "bg-success" : s.Status == SaleStatus.Held ? "bg-warning text-dark" : "bg-secondary")">@s.Status</span>
                        </td>
                        <td class="text-end">
                            @if (s.Status == SaleStatus.Held)
                            {
                                <a asp-action="Index" asp-route-resumeSaleId="@s.Id" class="btn btn-sm btn-warning fw-semibold"><i class="bi bi-play-fill"></i> Resume</a>
                            }
                            else
                            {
                                <a asp-action="Receipt" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer"></i> Receipt</a>
                                <a asp-controller="SalesReturns" asp-action="Index" asp-route-invoiceNumber="@s.InvoiceNumber" class="btn btn-sm btn-outline-danger">Return</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
