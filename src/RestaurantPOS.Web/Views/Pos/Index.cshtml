@{
    ViewData["Title"] = "Touchscreen POS Terminal";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var products = ViewBag.Products as List<ProductDto> ?? new List<ProductDto>();
    var tables = ViewBag.Tables as List<RestaurantTable> ?? new List<RestaurantTable>();
    var heldOrders = ViewBag.HeldOrders as List<Sale> ?? new List<Sale>();
    var resumedOrder = ViewBag.ResumedOrder as SaleReceiptDto;
}

<div class="row g-3">
    <!-- LEFT PANEL: Search, Category Pills & Touchscreen Product Grid -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white py-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-warning"></i></span>
                            <input type="text" id="posSearch" class="form-control border-start-0 ps-0" placeholder="Search dish name or scan barcode..." autofocus />
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        @if (heldOrders.Any())
                        {
                            <div class="dropdown d-inline">
                                <button class="btn btn-warning dropdown-toggle fw-bold shadow-sm" data-bs-toggle="dropdown">
                                    <i class="bi bi-pause-circle-fill me-1"></i>Held Orders (@heldOrders.Count)
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" style="min-width: 280px;">
                                    @foreach (var h in heldOrders)
                                    {
                                        <li class="px-2 py-1">
                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <a class="dropdown-item py-1 px-2 rounded flex-grow-1 small" asp-action="Index" asp-route-resumeSaleId="@h.Id">
                                                    <div class="fw-bold text-dark">@h.InvoiceNumber — Rs. @h.TotalAmount.ToString("N0")</div>
                                                    <div class="text-muted">
                                                        @h.OrderType @(h.RestaurantTable != null ? $"• Table {h.RestaurantTable.TableNumber}" : "") • @h.CustomerName (@h.SaleDetails.Count items)
                                                    </div>
                                                </a>
                                                <a asp-action="Receipt" asp-route-id="@h.Id" asp-route-autoPrint="true" class="btn btn-sm btn-outline-primary py-1 px-2" title="Print Hold Slip">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" title="Delete Held Order" onclick="event.stopPropagation(); cancelHeldOrder(@h.Id, '@h.InvoiceNumber')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-light text-secondary border py-2 px-3">
                                <i class="bi bi-check2-all text-success me-1"></i>No Held Orders
                            </span>
                        }
                    </div>
                </div>

                <!-- Category Filter Pills -->
                <div class="d-flex flex-wrap gap-2 mt-3" id="categoryButtons">
                    <button type="button" class="btn btn-sm btn-dark cat-filter active" data-cat="0">
                        <i class="bi bi-grid-fill me-1"></i>All Menu (@products.Count)
                    </button>
                    @foreach (var cat in categories)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary cat-filter" data-cat="@cat.Id">
                            @cat.Name
                        </button>
                    }
                </div>
            </div>

            <!-- Touchscreen Product Tiles -->
            <div class="card-body bg-light bg-opacity-50" style="max-height: 70vh; overflow-y: auto;">
                <div class="row g-2" id="productGrid">
                    @foreach (var p in products)
                    {
                        <div class="col-xl-3 col-md-4 col-6 product-tile"
                             data-cat="@p.CategoryId"
                             data-name="@p.Name.ToLower()"
                             data-barcode="@(p.Barcode?.ToLower() ?? "")">
                            <div class="pos-product-card @(p.IsLowStock ? "border-warning" : "")"
                                 onclick="addToCart(@p.Id, '@Html.Raw(p.Name.Replace("'", "\\'"))', @p.SalePrice, @p.CurrentStock)">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">@p.CategoryName</span>
                                        <span class="badge @(p.IsLowStock ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")" style="font-size: 0.65rem;">
                                            @p.CurrentStock.ToString("N0") @p.Unit
                                        </span>
                                    </div>
                                    <div class="fw-bold text-dark small lh-sm mt-1">@p.Name</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-light">
                                    <span class="price-pill">Rs. @p.SalePrice.ToString("N0")</span>
                                    <span class="btn btn-sm btn-light rounded-circle py-0 px-1 text-success">
                                        <i class="bi bi-plus-lg"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL: Active Order Cart & Instant Checkout -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white py-2">
                @if (resumedOrder != null)
                {
                    <div class="alert alert-warning py-1 px-2 mb-2 d-flex justify-content-between align-items-center small">
                        <div>
                            <i class="bi bi-pause-circle-fill me-1"></i>
                            <strong>Resumed Held Order:</strong> @resumedOrder.InvoiceNumber
                        </div>
                        <a asp-action="Index" class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size: 0.75rem;">New Order</a>
                    </div>
                }
                <!-- Interactive Order Type Buttons -->
                <input type="hidden" id="orderType" value="1" />
                <div class="btn-group w-100 order-type-selector mb-2" role="group">
                    <button type="button" class="btn btn-dark order-type-btn" data-type="1" onclick="selectOrderType(1)">
                        <i class="bi bi-shop-window me-1"></i>Dine In
                    </button>
                    <button type="button" class="btn btn-outline-secondary order-type-btn" data-type="2" onclick="selectOrderType(2)">
                        <i class="bi bi-bag-check me-1"></i>Takeaway
                    </button>
                    <button type="button" class="btn btn-outline-secondary order-type-btn" data-type="3" onclick="selectOrderType(3)">
                        <i class="bi bi-bicycle me-1"></i>Delivery
                    </button>
                </div>

                <div class="row g-2">
                    <div class="col-6" id="tableSelectWrap">
                        <select id="restaurantTableId" class="form-select form-select-sm fw-semibold">
                            <option value="">-- Select Dine-In Table --</option>
                            @foreach (var t in tables)
                            {
                                <option value="@t.Id">@t.TableNumber (@t.Capacity Seats - @t.Status)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6" id="customerNameWrap">
                        <input type="text" id="customerName" class="form-control form-control-sm" value="Walk-In Customer" placeholder="Customer Name" />
                    </div>
                    <div class="col-6 d-none" id="deliveryPhoneWrap">
                        <input type="text" id="customerPhone" class="form-control form-control-sm" placeholder="Phone (03xx-...)" />
                    </div>
                    <div class="col-6 d-none" id="deliveryAddrWrap">
                        <input type="text" id="deliveryAddress" class="form-control form-control-sm" placeholder="Delivery Address..." />
                    </div>
                </div>
            </div>

            <!-- Cart Items List -->
            <div class="card-body p-0" style="max-height: 33vh; overflow-y: auto;">
                <table class="table table-sm align-middle mb-0">
                    <thead class="sticky-top">
                        <tr>
                            <th class="ps-3">Dish / Item</th>
                            <th class="text-center" style="width:120px;">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Total</th>
                            <th class="pe-2"></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody">
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-basket2 fs-2 d-block mb-1 opacity-50"></i>
                                Tap any menu item on the left to add to bill
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Bill Calculation & Checkout Footer -->
            <div class="card-footer bg-white border-top pt-3">
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="small text-muted fw-semibold">Subtotal</label>
                        <input type="text" id="subTotalDisplay" class="form-control form-control-sm fw-bold bg-light" value="0.00" readonly />
                    </div>
                    <div class="col-4">
                        <label class="small text-muted fw-semibold">Discount (Rs)</label>
                        <input type="number" id="discountInput" class="form-control form-control-sm fw-bold" value="0" min="0" oninput="recalcTotals()" />
                    </div>
                    <div class="col-4">
                        <label class="small text-muted fw-semibold">Tax (%)</label>
                        <input type="number" id="taxPctInput" class="form-control form-control-sm" value="0" min="0" max="100" oninput="recalcTotals()" />
                    </div>
                </div>

                <!-- Dark Grand Total Display -->
                <div class="grand-total-banner d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="small text-white-50 fw-semibold">PAYABLE GRAND TOTAL</div>
                        <span class="badge bg-warning text-dark" id="cartCountBadge">0 Items</span>
                    </div>
                    <div class="fs-2 fw-extrabold text-warning font-mono" id="grandTotalDisplay">Rs. 0.00</div>
                </div>

                <!-- Payment Method & Quick Cash Tender Buttons -->
                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-4">
                        <label class="small fw-semibold">Payment Mode</label>
                        <select id="paymentMethod" class="form-select form-select-sm fw-bold" onchange="toggleSplitPayment()">
                            <option value="1">💵 Cash</option>
                            <option value="2">💳 Card</option>
                            <option value="3">📱 Online</option>
                            <option value="4">⚖️ Split</option>
                        </select>
                    </div>
                    <div class="col-4" id="singleReceivedWrap">
                        <label class="small fw-semibold">Cash Received</label>
                        <input type="number" id="receivedAmount" class="form-control form-control-sm fw-bold border-primary" value="0" oninput="recalcTotals()" />
                    </div>
                    <div class="col-4">
                        <label class="small fw-semibold">Change Return</label>
                        <input type="text" id="changeDisplay" class="form-control form-control-sm fw-bold text-success bg-success-subtle" value="0.00" readonly />
                    </div>
                </div>

                <!-- 1-Tap Quick Cash Buttons -->
                <div class="d-flex flex-wrap gap-1 mb-2" id="quickCashRow">
                    <button type="button" class="btn btn-outline-secondary quick-cash-btn flex-grow-1" onclick="setQuickCash('exact')">Exact Cash</button>
                    <button type="button" class="btn btn-outline-secondary quick-cash-btn flex-grow-1" onclick="setQuickCash(500)">Rs. 500</button>
                    <button type="button" class="btn btn-outline-secondary quick-cash-btn flex-grow-1" onclick="setQuickCash(1000)">Rs. 1000</button>
                    <button type="button" class="btn btn-outline-secondary quick-cash-btn flex-grow-1" onclick="setQuickCash(2000)">Rs. 2000</button>
                    <button type="button" class="btn btn-outline-secondary quick-cash-btn flex-grow-1" onclick="setQuickCash(5000)">Rs. 5000</button>
                </div>

                <!-- Split Payment Breakdown Box -->
                <div class="row g-2 mb-2 d-none border rounded-3 p-2 bg-light" id="splitPaymentBox">
                    <div class="col-4">
                        <label class="small fw-semibold">Cash (Rs)</label>
                        <input type="number" id="splitCash" class="form-control form-control-sm" value="0" oninput="recalcTotals()" />
                    </div>
                    <div class="col-4">
                        <label class="small fw-semibold">Card (Rs)</label>
                        <input type="number" id="splitCard" class="form-control form-control-sm" value="0" oninput="recalcTotals()" />
                    </div>
                    <div class="col-4">
                        <label class="small fw-semibold">Online (Rs)</label>
                        <input type="number" id="splitOnline" class="form-control form-control-sm" value="0" oninput="recalcTotals()" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="button" id="btnCompletePrint" class="btn btn-success flex-grow-1 fw-bold py-2 shadow-sm" onclick="submitPosOrder(false)">
                        <i class="bi bi-printer-fill me-1"></i>Complete & Print Bill
                    </button>
                    <button type="button" id="btnHoldOrder" class="btn btn-warning fw-bold px-3" onclick="submitPosOrder(true)">
                        <i class="bi bi-pause-fill me-1"></i>Hold
                    </button>
                    <button type="button" class="btn btn-outline-danger px-3" onclick="clearCart()" title="Clear Cart">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cart = [];
    let currentGrandTotal = 0;
    let resumedSaleId = @(resumedOrder != null ? resumedOrder.SaleId : "null");
    let clientRequestToken = crypto.randomUUID ? crypto.randomUUID() : ('REQ-' + Date.now() + '-' + Math.random());

    @if (resumedOrder != null)
    {
        <text>
        cart = [
            @foreach (var item in resumedOrder.Items)
            {
                @:{ productId: @item.ProductId, name: '@Html.Raw(item.ProductName.Replace("'", "\\'"))', price: @item.UnitPrice, quantity: @item.Quantity },
            }
        ];
        $(function() {
            selectOrderType(@((int)resumedOrder.OrderType));
            @if (resumedOrder.RestaurantTableId.HasValue)
            {
                @:$('#restaurantTableId').val('@resumedOrder.RestaurantTableId.Value');
            }
            $('#customerName').val('@Html.Raw((resumedOrder.CustomerName ?? "Walk-In Customer").Replace("'", "\\'"))');
            $('#customerPhone').val('@Html.Raw((resumedOrder.CustomerPhone ?? "").Replace("'", "\\'"))');
            $('#deliveryAddress').val('@Html.Raw((resumedOrder.DeliveryAddress ?? "").Replace("'", "\\'"))');
            $('#discountInput').val('@resumedOrder.DiscountAmount');
            $('#taxPctInput').val('@resumedOrder.TaxPercentage');
            renderCart();
        });
        </text>
    }

    function selectOrderType(typeId) {
        $('#orderType').val(typeId);
        $('.order-type-btn').removeClass('btn-dark').addClass('btn-outline-secondary');
        $(`.order-type-btn[data-type="${typeId}"]`).removeClass('btn-outline-secondary').addClass('btn-dark');
        $('#tableSelectWrap').toggleClass('d-none', typeId !== 1);
        $('#customerNameWrap').toggleClass('col-12', typeId !== 1).toggleClass('col-6', typeId === 1);
        $('#deliveryPhoneWrap, #deliveryAddrWrap').toggleClass('d-none', typeId !== 3);
    }

    function setQuickCash(val) {
        if (val === 'exact') {
            $('#receivedAmount').val(currentGrandTotal.toFixed(0));
        } else {
            $('#receivedAmount').val(val);
        }
        recalcTotals();
    }

    function addToCart(productId, name, price, stock) {
        const existing = cart.find(i => i.productId === productId);
        if (existing) {
            existing.quantity += 1;
        } else {
            cart.push({ productId, name, price: parseFloat(price), quantity: 1 });
        }
        renderCart();
    }

    function updateQty(productId, delta) {
        const item = cart.find(i => i.productId === productId);
        if (!item) return;
        item.quantity += delta;
        if (item.quantity <= 0) {
            cart = cart.filter(i => i.productId !== productId);
        }
        renderCart();
    }

    function removeItem(productId) {
        cart = cart.filter(i => i.productId !== productId);
        renderCart();
    }

    function clearCart() {
        cart = [];
        resumedSaleId = null;
        clientRequestToken = 'REQ-' + Date.now() + '-' + Math.random();
        $('#discountInput').val(0);
        $('#receivedAmount').val(0);
        renderCart();
    }

    function renderCart() {
        const tbody = $('#cartBody');
        tbody.empty();
        const totalUnits = cart.reduce((s, i) => s + i.quantity, 0);
        $('#cartCountBadge').text(`${totalUnits} Item${totalUnits === 1 ? '' : 's'}`);

        if (cart.length === 0) {
            tbody.append(`
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <i class="bi bi-basket2 fs-2 d-block mb-1 opacity-50"></i>
                        Tap any menu item on the left to add to bill
                    </td>
                </tr>`);
            recalcTotals();
            return;
        }

        cart.forEach(item => {
            const lineTotal = (item.quantity * item.price).toFixed(0);
            tbody.append(`
                <tr>
                    <td class="ps-3 fw-semibold small">${item.name}</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary px-2 py-0" onclick="updateQty(${item.productId}, -1)">-</button>
                            <span class="btn btn-light disabled fw-bold px-2 py-0 text-dark">${item.quantity}</span>
                            <button type="button" class="btn btn-outline-secondary px-2 py-0" onclick="updateQty(${item.productId}, 1)">+</button>
                        </div>
                    </td>
                    <td class="text-end small text-muted">${item.price.toFixed(0)}</td>
                    <td class="text-end fw-bold small">Rs. ${lineTotal}</td>
                    <td class="text-end pe-2">
                        <button type="button" class="btn btn-sm text-danger p-0" onclick="removeItem(${item.productId})"><i class="bi bi-x-circle-fill"></i></button>
                    </td>
                </tr>
            `);
        });
        recalcTotals();
    }

    function recalcTotals() {
        const subTotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
        const discount = Math.min(subTotal, Math.max(0, parseFloat($('#discountInput').val()) || 0));
        const taxPct = Math.max(0, parseFloat($('#taxPctInput').val()) || 0);
        const taxable = subTotal - discount;
        const taxAmt = Math.round(taxable * (taxPct / 100) * 100) / 100;
        currentGrandTotal = Math.round((taxable + taxAmt) * 100) / 100;

        $('#subTotalDisplay').val(subTotal.toFixed(2));
        $('#grandTotalDisplay').text('Rs. ' + currentGrandTotal.toFixed(2));

        const payMethod = parseInt($('#paymentMethod').val());
        let received = 0;
        if (payMethod === 4) {
            received = (parseFloat($('#splitCash').val()) || 0) +
                       (parseFloat($('#splitCard').val()) || 0) +
                       (parseFloat($('#splitOnline').val()) || 0);
        } else {
            received = parseFloat($('#receivedAmount').val()) || 0;
        }

        const change = Math.max(0, received - currentGrandTotal);
        $('#changeDisplay').val(change.toFixed(2));
    }

    function toggleSplitPayment() {
        const payMethod = parseInt($('#paymentMethod').val());
        $('#splitPaymentBox').toggleClass('d-none', payMethod !== 4);
        $('#singleReceivedWrap, #quickCashRow').toggleClass('d-none', payMethod === 4);
        recalcTotals();
    }

    function cancelHeldOrder(saleId, invoiceNo) {
        if (!confirm(`Delete held order ${invoiceNo}?`)) return;
        $.ajax({
            url: '@Url.Action("CancelHeldOrder", "Pos")?id=' + saleId,
            type: 'POST',
            success: function() {
                window.location.href = '@Url.Action("Index", "Pos")';
            },
            error: function(xhr) {
                alert(xhr.responseJSON?.message || 'Error deleting held order.');
            }
        });
    }

    function submitPosOrder(isHold) {
        if (cart.length === 0) {
            alert('Please add at least one product to the cart.');
            return;
        }

        const payMethod = parseInt($('#paymentMethod').val());
        const splitPayments = [];
        if (payMethod === 4 && !isHold) {
            const c = parseFloat($('#splitCash').val()) || 0;
            const d = parseFloat($('#splitCard').val()) || 0;
            const o = parseFloat($('#splitOnline').val()) || 0;
            if (c > 0) splitPayments.push({ paymentMethod: 1, amount: c });
            if (d > 0) splitPayments.push({ paymentMethod: 2, amount: d });
            if (o > 0) splitPayments.push({ paymentMethod: 3, amount: o });
        }

        const payload = {
            resumedSaleId: resumedSaleId,
            clientRequestToken: clientRequestToken,
            orderType: parseInt($('#orderType').val()),
            restaurantTableId: $('#restaurantTableId').val() ? parseInt($('#restaurantTableId').val()) : null,
            customerName: $('#customerName').val(),
            customerPhone: $('#customerPhone').val(),
            deliveryAddress: $('#deliveryAddress').val(),
            discountAmount: parseFloat($('#discountInput').val()) || 0,
            taxPercentage: parseFloat($('#taxPctInput').val()) || 0,
            paymentMethod: payMethod,
            receivedAmount: parseFloat($('#receivedAmount').val()) || 0,
            isHoldOrder: isHold,
            items: cart.map(i => ({ productId: i.productId, quantity: i.quantity, discountAmount: 0 })),
            splitPayments: splitPayments
        };

        $('#btnCompletePrint, #btnHoldOrder').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("SubmitOrder", "Pos")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                window.location.href = res.receiptUrl;
            },
            error: function(xhr) {
                $('#btnCompletePrint, #btnHoldOrder').prop('disabled', false);
                const msg = xhr.responseJSON?.message || 'Error saving sale.';
                alert(msg);
            }
        });
    }

    // Category & Search Filtering
    $('.cat-filter').on('click', function() {
        $('.cat-filter').removeClass('active btn-dark').addClass('btn-outline-secondary');
        $(this).removeClass('btn-outline-secondary').addClass('active btn-dark');
        const catId = parseInt($(this).data('cat'));
        $('.product-tile').each(function() {
            const match = catId === 0 || parseInt($(this).data('cat')) === catId;
            $(this).toggle(match);
        });
    });

    $('#posSearch').on('input', function() {
        const q = $(this).val().toLowerCase().trim();
        $('.product-tile').each(function() {
            const name = $(this).data('name') || '';
            const barcode = $(this).data('barcode') || '';
            $(this).toggle(name.includes(q) || barcode.includes(q));
        });
    });
</script>
}
