@model DailyBusinessReportDto
@{
    ViewData["Title"] = "Daily Business Report";
}
<div class="card mb-3 no-print">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <div class="btn-group btn-group-sm">
                    <a asp-action="DailyReport" asp-route-preset="Today" class="btn @(Model.FilterPreset == "Today" ? "btn-dark" : "btn-outline-dark")">Today's Business Day</a>
                    <a asp-action="DailyReport" asp-route-preset="Yesterday" class="btn @(Model.FilterPreset == "Yesterday" ? "btn-dark" : "btn-outline-dark")">Yesterday</a>
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">From Business Date</label>
                <input type="date" name="startDate" value="@Model.StartBusinessDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0 fw-semibold">To Business Date</label>
                <input type="date" name="endDate" value="@Model.EndBusinessDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <input type="hidden" name="preset" value="Custom" />
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Generate Report</button>
            </div>
            <div class="col-auto ms-auto d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-dark" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Print / Save PDF
                </button>
                <a asp-action="ExportExcel"
                   asp-route-startDate="@Model.StartBusinessDate.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndBusinessDate.ToString("yyyy-MM-dd")"
                   asp-route-preset="@Model.FilterPreset"
                   class="btn btn-sm btn-success">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Report Header Banner -->
<div class="card mb-3 border-top border-4 border-primary">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">DAILY BUSINESS REPORT</h4>
            <div class="small text-muted">
                Selected Business Date:
                <strong class="text-dark">
                    @(Model.StartBusinessDate == Model.EndBusinessDate
                        ? Model.StartBusinessDate.ToString("dd MMMM yyyy")
                        : $"{Model.StartBusinessDate:dd MMM yyyy} – {Model.EndBusinessDate:dd MMM yyyy}")
                </strong>
            </div>
            <div class="small text-primary fw-semibold">
                Exact Shift Window: From @Model.ExactWindowStart.ToString("dd MMMM yyyy, hh:mm tt") To @Model.ExactWindowEnd.ToString("dd MMMM yyyy, hh:mm tt") (Pakistan Standard Time)
            </div>
        </div>
        <div class="text-end">
            <div class="small text-muted">Total Completed Orders: <strong>@Model.TotalOrders</strong></div>
            <div class="small text-muted">Average Order Value: <strong>Rs. @Model.AverageOrderValue.ToString("N2")</strong></div>
        </div>
    </div>
</div>

<!-- 12 Core Financial Metrics Grid -->
<div class="row g-2 mb-3">
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">1. Total Gross Sales</span>
            <h5 class="fw-bold mb-0">Rs. @Model.TotalGrossSales.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">2. Total Discounts</span>
            <h5 class="fw-bold text-warning mb-0">Rs. @Model.TotalDiscounts.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">3. Sales Returns</span>
            <h5 class="fw-bold text-danger mb-0">Rs. @Model.SalesReturns.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-success-subtle">
            <span class="small text-dark fw-semibold">4. Net Sales</span>
            <h5 class="fw-bold text-success mb-0">Rs. @Model.NetSales.ToString("N2")</h5>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">5. Cash Received (Net)</span>
            <h5 class="fw-bold text-success mb-0">Rs. @Model.CashReceived.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">6. Card Payments</span>
            <h5 class="fw-bold text-primary mb-0">Rs. @Model.CardPayments.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">7. Online Payments</span>
            <h5 class="fw-bold text-info mb-0">Rs. @Model.OnlinePayments.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">8. Total Expenses</span>
            <h5 class="fw-bold text-danger mb-0">Rs. @Model.TotalExpenses.ToString("N2")</h5>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">9. Purchase Amount</span>
            <h5 class="fw-bold mb-0">Rs. @Model.PurchaseAmount.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-white">
            <span class="small text-muted">10. Est. Cost of Goods Sold</span>
            <h5 class="fw-bold mb-0">Rs. @Model.EstimatedCostOfGoodsSold.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-info-subtle">
            <span class="small text-dark fw-semibold">11. Gross Profit</span>
            <h5 class="fw-bold text-primary mb-0">Rs. @Model.GrossProfit.ToString("N2")</h5>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card p-3 bg-dark text-white">
            <span class="small text-warning fw-semibold">12. Net Profit (Estimated)</span>
            <h5 class="fw-bold text-warning mb-0">Rs. @Model.EstimatedNetProfit.ToString("N2")</h5>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Product-Wise Sales -->
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">Product-Wise Sales Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Gross</th>
                            <th class="text-end">Net Sales</th>
                            <th class="text-end">COGS</th>
                            <th class="text-end">Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.ProductWiseSales)
                        {
                            <tr>
                                <td class="fw-semibold">@p.ProductName</td>
                                <td>@p.CategoryName</td>
                                <td class="text-end">@p.QuantitySold.ToString("N2")</td>
                                <td class="text-end">Rs. @p.GrossAmount.ToString("N2")</td>
                                <td class="text-end fw-bold">Rs. @p.NetAmount.ToString("N2")</td>
                                <td class="text-end">Rs. @p.EstimatedCost.ToString("N2")</td>
                                <td class="text-end text-success">Rs. @p.EstimatedProfit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Category-Wise & Payment-Wise -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-white fw-bold">Category-Wise Sales</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Sales</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CategoryWiseSales)
                                {
                                    <tr>
                                        <td>@c.CategoryName</td>
                                        <td class="text-end">@c.QuantitySold.ToString("N0")</td>
                                        <td class="text-end fw-bold">Rs. @c.TotalSalesAmount.ToString("N2")</td>
                                        <td class="text-end">@c.PercentageOfSales%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-white fw-bold">Payment-Wise Sales</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Method</th>
                                    <th class="text-end">Txns</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pm in Model.PaymentWiseSales)
                                {
                                    <tr>
                                        <td class="fw-semibold">@pm.PaymentMethod</td>
                                        <td class="text-end">@pm.TransactionCount</td>
                                        <td class="text-end fw-bold">Rs. @pm.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hourly Sales Breakdown (6:00 PM to 4:00 AM Shift) -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-bold">Hourly Sales Report (6:00 PM – Next Day 4:00 AM)</div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Shift Hour Slot</th>
                            <th class="text-end">Orders</th>
                            <th class="text-end">Sales Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.HourlySales)
                        {
                            <tr class="@(h.Hour24 < 4 ? "table-info" : "")">
                                <td class="small fw-semibold">@h.HourLabel</td>
                                <td class="text-end">@h.OrderCount</td>
                                <td class="text-end fw-bold">Rs. @h.TotalSales.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
