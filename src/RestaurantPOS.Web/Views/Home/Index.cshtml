@model DailyBusinessReportDto
@{
    ViewData["Title"] = "Executive Dashboard";
}
<!-- Hero Banner -->
<div class="card border-0 mb-4 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-info bg-opacity-10 border border-info border-opacity-25 text-info small fw-semibold mb-2">
                <i class="bi bi-clock-history"></i>
                <span>6:00 PM to Next-Day 4:00 AM Shift Window (Pakistan Standard Time)</span>
            </div>
            <h3 class="fw-extrabold mb-1">Business Date: @Model.StartBusinessDate.ToString("dddd, dd MMMM yyyy")</h3>
            <div class="text-white-50 small">
                Active Window: <strong class="text-light">@Model.ExactWindowStart.ToString("dd MMM, hh:mm tt")</strong>
                <i class="bi bi-arrow-right mx-1"></i>
                <strong class="text-light">@Model.ExactWindowEnd.ToString("dd MMM, hh:mm tt")</strong>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Pos" asp-action="Index" class="btn btn-warning px-4 py-2 fw-bold shadow">
                <i class="bi bi-display me-2"></i>Open POS Screen
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Reports" asp-action="DailyReport" class="btn btn-info text-dark fw-bold px-3 py-2">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i>Full Daily Report
                </a>
            }
        </div>
    </div>
</div>

<!-- Row 1: 4 Primary KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Net Shift Sales</div>
                    <h3 class="fw-extrabold text-dark mb-1">Rs. @Model.NetSales.ToString("N0")</h3>
                    <span class="badge bg-success-subtle text-success">Gross: Rs. @Model.TotalGrossSales.ToString("N0")</span>
                </div>
                <div class="kpi-icon-box kpi-success"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Orders</div>
                    <h3 class="fw-extrabold text-dark mb-1">@Model.TotalOrders <small class="fs-6 fw-normal text-muted">orders</small></h3>
                    <span class="badge bg-primary-subtle text-primary">Avg Order: Rs. @Model.AverageOrderValue.ToString("N0")</span>
                </div>
                <div class="kpi-icon-box kpi-primary"><i class="bi bi-receipt"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Est. Gross Profit</div>
                    <h3 class="fw-extrabold text-info mb-1">Rs. @Model.GrossProfit.ToString("N0")</h3>
                    <span class="badge bg-info-subtle text-info">Net Profit: Rs. @Model.EstimatedNetProfit.ToString("N0")</span>
                </div>
                <div class="kpi-icon-box kpi-info"><i class="bi bi-pie-chart-fill"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Expenses & Purchases</div>
                    <h4 class="fw-extrabold text-danger mb-1">Rs. @Model.TotalExpenses.ToString("N0")</h4>
                    <span class="badge bg-danger-subtle text-danger">Purchases: Rs. @Model.PurchaseAmount.ToString("N0")</span>
                </div>
                <div class="kpi-icon-box kpi-danger"><i class="bi bi-wallet2"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Payment Channels Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card p-3 border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Cash Sales (Net)</div>
                    <h4 class="fw-bold text-success mb-0">Rs. @Model.CashReceived.ToString("N2")</h4>
                </div>
                <i class="bi bi-cash-stack fs-2 text-success opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card p-3 border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Card / POS Machine</div>
                    <h4 class="fw-bold text-primary mb-0">Rs. @Model.CardPayments.ToString("N2")</h4>
                </div>
                <i class="bi bi-credit-card-2-front fs-2 text-primary opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card p-3 border-start border-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Online / Raast / Wallets</div>
                    <h4 class="fw-bold text-info mb-0">Rs. @Model.OnlinePayments.ToString("N2")</h4>
                </div>
                <i class="bi bi-qr-code-scan fs-2 text-info opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Top Products & Low Stock Alerts -->
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-trophy-fill text-warning me-2"></i>Top Selling Items Today</span>
                <span class="badge bg-light text-secondary border">Shift 6 PM – 4 AM</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Item Name</th>
                                <th>Category</th>
                                <th class="text-center">Qty Sold</th>
                                <th class="text-end">Net Sales</th>
                                <th class="text-end pe-3">Est. Profit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ProductWiseSales.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">
                                        <i class="bi bi-cart-x fs-2 d-block mb-2 opacity-50"></i>
                                        No sales recorded yet for this shift. Click <strong>Open POS Screen</strong> to punch your first order!
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.ProductWiseSales.Take(8))
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@item.ProductName</td>
                                    <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                                    <td class="text-center fw-bold">@item.QuantitySold.ToString("N0")</td>
                                    <td class="text-end fw-semibold">Rs. @item.NetAmount.ToString("N0")</td>
                                    <td class="text-end pe-3 text-success fw-bold">Rs. @item.EstimatedProfit.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Low Stock Alerts (@Model.LowStockProducts.Count)</span>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-outline-danger py-0">Restock</a>
                }
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Product</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-end pe-3">Min Required</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.LowStockProducts.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-success py-5">
                                    <i class="bi bi-check2-circle fs-2 d-block mb-1"></i>
                                    All menu items have healthy stock levels!
                                </td>
                            </tr>
                        }
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@p.Name</td>
                                <td class="text-end"><span class="badge bg-danger">@p.CurrentStock.ToString("N1") @p.Unit</span></td>
                                <td class="text-end pe-3 text-muted small">@p.MinimumStock.ToString("N1") @p.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
