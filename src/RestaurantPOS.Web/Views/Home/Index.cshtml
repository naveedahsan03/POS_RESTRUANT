@model DailyBusinessReportDto
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Restaurant Business Dashboard</h4>
        <div class="text-muted small">
            Active Business Date: <strong class="text-dark">@Model.StartBusinessDate.ToString("dd MMMM yyyy")</strong> |
            Shift Window: <strong>@Model.ExactWindowStart.ToString("dd MMM yyyy, hh:mm tt")</strong> to <strong>@Model.ExactWindowEnd.ToString("dd MMM yyyy, hh:mm tt")</strong> (Asia/Karachi)
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Pos" asp-action="Index" class="btn btn-warning fw-bold"><i class="bi bi-display me-1"></i>Launch POS</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Reports" asp-action="DailyReport" class="btn btn-outline-primary"><i class="bi bi-file-earmark-bar-graph me-1"></i>Full Daily Report</a>
        }
    </div>
</div>

<!-- Row 1: Primary KPI Cards -->
<div class="row g-3 mb-3">
    <div class="col-md-3 col-sm-6">
        <div class="card border-start border-4 border-primary h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Today's Gross Sales</div>
                <h3 class="fw-bold text-primary mb-0">Rs. @Model.TotalGrossSales.ToString("N2")</h3>
                <small class="text-muted">Discounts: Rs. @Model.TotalDiscounts.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-start border-4 border-success h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Net Sales</div>
                <h3 class="fw-bold text-success mb-0">Rs. @Model.NetSales.ToString("N2")</h3>
                <small class="text-muted">Orders: <strong>@Model.TotalOrders</strong> (Held: @Model.HeldOrdersCount)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-start border-4 border-info h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Estimated Gross Profit</div>
                <h3 class="fw-bold text-info mb-0">Rs. @Model.GrossProfit.ToString("N2")</h3>
                <small class="text-muted">Est. Net Profit: Rs. @Model.EstimatedNetProfit.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-start border-4 border-danger h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Expenses & Returns</div>
                <h5 class="fw-bold text-danger mb-1">Exp: Rs. @Model.TotalExpenses.ToString("N2")</h5>
                <small class="text-muted">Sales Returns: Rs. @Model.SalesReturns.ToString("N2") | Purchases: Rs. @Model.PurchaseAmount.ToString("N2")</small>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Payment Channels -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Cash Sales (Net of Cash Refunds)</span>
                    <h4 class="fw-bold mb-0 text-success">Rs. @Model.CashReceived.ToString("N2")</h4>
                </div>
                <i class="bi bi-cash-coin fs-1 text-success opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Card Payments</span>
                    <h4 class="fw-bold mb-0 text-primary">Rs. @Model.CardPayments.ToString("N2")</h4>
                </div>
                <i class="bi bi-credit-card-2-front fs-1 text-primary opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Online / JazzCash / EasyPaisa / Bank</span>
                    <h4 class="fw-bold mb-0 text-info">Rs. @Model.OnlinePayments.ToString("N2")</h4>
                </div>
                <i class="bi bi-phone-vibrate fs-1 text-info opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Top Selling Products Today -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">Today's Product-Wise Sales (6:00 PM – 4:00 AM)</div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Net Sales</th>
                            <th class="text-end">Est. Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ProductWiseSales.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No sales recorded yet for this Business Day.</td></tr>
                        }
                        @foreach (var item in Model.ProductWiseSales.Take(10))
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td>@item.CategoryName</td>
                                <td class="text-end">@item.QuantitySold.ToString("N2")</td>
                                <td class="text-end">Rs. @item.NetAmount.ToString("N2")</td>
                                <td class="text-end text-success">Rs. @item.EstimatedProfit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold text-danger"><i class="bi bi-exclamation-octagon me-1"></i>Low Stock Alerts (@Model.LowStockProducts.Count)</span>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-outline-danger">Add Purchase</a>
                }
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-end">Min Alert</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.LowStockProducts.Any())
                        {
                            <tr><td colspan="3" class="text-center text-success py-3">All products are above minimum stock levels.</td></tr>
                        }
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Name</td>
                                <td class="text-end text-danger fw-bold">@p.CurrentStock.ToString("N2") @p.Unit</td>
                                <td class="text-end text-muted">@p.MinimumStock.ToString("N2") @p.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
