@model List<SalesReturn>
@{
    ViewData["Title"] = "Sales Returns";
    var searchedSale = ViewBag.SearchedSale as SaleReceiptDto;
}
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white fw-bold"><i class="bi bi-search me-2"></i>Find Original Sale Invoice</div>
            <div class="card-body">
                <form method="get" class="d-flex gap-2">
                    <input name="invoiceNumber" value="@ViewBag.SearchInvoice" class="form-control" placeholder="Enter Invoice # (e.g. INV-20261117-0001)" required />
                    <button type="submit" class="btn btn-primary px-4">Search</button>
                </form>
            </div>
        </div>

        @if (searchedSale != null)
        {
            <div class="card border-danger">
                <div class="card-header bg-danger text-white fw-bold">
                    Original Invoice: @searchedSale.InvoiceNumber | Business Date: @searchedSale.BusinessDate.ToString("dd MMM yyyy")
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="SaleId" value="@searchedSale.SaleId" />
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sold Item</th>
                                    <th class="text-end">Sold Qty</th>
                                    <th class="text-end">Returned</th>
                                    <th class="text-end">Unit Price</th>
                                    <th style="width:130px;">Return Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < searchedSale.Items.Count; i++)
                                {
                                    var item = searchedSale.Items[i];
                                    var maxRet = item.Quantity - item.AlreadyReturnedQuantity;
                                    <tr>
                                        <td>
                                            @item.ProductName
                                            <input type="hidden" name="Items[@i].SaleDetailId" value="@item.SaleDetailId" />
                                            <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                        </td>
                                        <td class="text-end">@item.Quantity.ToString("N2")</td>
                                        <td class="text-end text-danger">@item.AlreadyReturnedQuantity.ToString("N2")</td>
                                        <td class="text-end">Rs. @item.UnitPrice.ToString("N2")</td>
                                        <td>
                                            <input name="Items[@i].ReturnQuantity" type="number" step="0.01" min="0" max="@maxRet" value="0" class="form-control form-control-sm" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Refund Method</label>
                                <select name="RefundMethod" class="form-select form-select-sm">
                                    <option value="1">Cash Refund</option>
                                    <option value="2">Card Reversal</option>
                                    <option value="3">Online Refund</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Return Reason *</label>
                                <input name="Reason" class="form-control form-control-sm" placeholder="Customer changed order, wrong item..." required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold">Process Sales Return & Restore Stock</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white fw-bold">Sales Returns Log (@Model.Count)</div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Return #</th>
                            <th>Original Invoice</th>
                            <th>Business Date</th>
                            <th>Reason</th>
                            <th class="text-end">Refund Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-bold">@r.ReturnNumber</td>
                                <td>@r.OriginalInvoiceNumber</td>
                                <td>@r.BusinessDate.ToString("dd MMM yyyy")</td>
                                <td>@r.Reason</td>
                                <td class="text-end fw-bold text-danger">Rs. @r.TotalRefundAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
