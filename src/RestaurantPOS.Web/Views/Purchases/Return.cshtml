@model Purchase
@{
    ViewData["Title"] = $"Purchase Return - {Model.PurchaseInvoiceNumber}";
    var returnedByDetail = Model.PurchaseReturns
        .SelectMany(r => r.PurchaseReturnDetails)
        .GroupBy(d => d.PurchaseDetailId)
        .ToDictionary(g => g.Key, g => g.Sum(x => x.ReturnQuantity));
}
<div class="card">
    <div class="card-header bg-danger text-white fw-bold">
        Process Purchase Return against @Model.PurchaseInvoiceNumber (Supplier: @Model.Supplier?.Name)
    </div>
    <div class="card-body">
        <form asp-action="CreateReturn" method="post">
            <input type="hidden" name="PurchaseId" value="@Model.Id" />
            <table class="table table-bordered table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Purchased Qty</th>
                        <th class="text-end">Already Returned</th>
                        <th class="text-end">Purchase Price</th>
                        <th style="width:160px;">Return Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 0; }
                    @foreach (var d in Model.PurchaseDetails)
                    {
                        var prevRet = returnedByDetail.TryGetValue(d.Id, out var rQty) ? rQty : 0m;
                        var maxRem = d.Quantity - prevRet;
                        <tr>
                            <td>
                                @d.Product?.Name
                                <input type="hidden" name="Items[@idx].PurchaseDetailId" value="@d.Id" />
                                <input type="hidden" name="Items[@idx].ProductId" value="@d.ProductId" />
                            </td>
                            <td class="text-end">@d.Quantity.ToString("N2")</td>
                            <td class="text-end text-danger">@prevRet.ToString("N2")</td>
                            <td class="text-end">Rs. @d.PurchasePrice.ToString("N2")</td>
                            <td>
                                <input name="Items[@idx].ReturnQuantity" type="number" step="0.01" min="0" max="@maxRem" value="0" class="form-control form-control-sm" />
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>

            <div class="mb-3">
                <label class="form-label fw-semibold">Return Reason *</label>
                <input name="Reason" class="form-control" placeholder="Damaged goods, expired stock, wrong delivery..." required />
            </div>

            <button type="submit" class="btn btn-danger fw-bold">Confirm Purchase Return & Deduct Stock</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
